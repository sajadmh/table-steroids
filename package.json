{
  "name": "table-steroids",
  "version": "0.3.0",
  "description": "Spreadsheet-style selection, copy, and range superpowers for native HTML tables.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sajadmh/table-steroids.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/core.js",
    "dist/core.d.ts",
    "dist/dom.js",
    "dist/dom.d.ts",
    "dist/react.js",
    "dist/react.d.ts",
    "dist/core/**/*.js",
    "dist/core/**/*.d.ts",
    "dist/dom/**/*.js",
    "dist/dom/**/*.d.ts",
    "dist/react/**/*.js",
    "dist/react/**/*.d.ts",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:types": "tsc -p ./tsconfig.json",
    "build:browser": "node ./scripts/build-browser-bundle.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
